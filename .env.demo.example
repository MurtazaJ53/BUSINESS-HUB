# Copy to .env.demo and fill in. Never commit .env.demo.
#
#   cp .env.demo.example .env.demo

# --- Database (stays inside Docker) ---
POSTGRES_USER=bhub
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=business_hub

# --- Django ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_ENV=development
# Must list every host/domain/IP the API is reached on.
# Behind Nginx subdomain:  api.yourdomain.com
# Quick IP:port demo:      157.245.102.242,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=157.245.102.242,localhost,127.0.0.1

# --- Email (optional; leave blank to disable invite/notification emails) ---
RESEND_API_KEY=
RESEND_FROM=

# --- Platform admin auto-bootstrap (optional) ---
ENSURE_PLATFORM_ADMIN_EMAIL=
ENSURE_PLATFORM_ADMIN_PASSWORD=
