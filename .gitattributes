# Normalize line endings so cross-platform checkouts don't churn diffs.
* text=auto eol=lf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.zip binary
